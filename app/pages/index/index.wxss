page, .container {
  min-height: 100vh;
  background: #f0f4ff;
  font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}
.navbar {
  display: flex;
  align-items: center;
  height: 60rpx;
  background: #fff;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.05);
  padding: 0 30rpx;
  border-radius: 0 0 20rpx 20rpx;
}
.logo {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}
.title {
  font-size: 32rpx;
  color: #6e44ff;
  font-weight: bold;
}
.main {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
}
.info-panel {
  width: 90vw;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 5rpx 25rpx rgba(0,0,0,0.08);
  padding: 30rpx 20rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.robot {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}
.brand {
  font-size: 28rpx;
  color: #6e44ff;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.desc {
  color: #2e2e3a;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  text-align: center;
}
.features {
  width: 100%;
}
.feature-title {
  color: #6e44ff;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.feature-list text {
  display: block;
  color: #444;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}
.ai-area {
  width: 100vw;
  min-height: 600rpx;
  margin-top: 20rpx;
}
